{
  "name": "magicframe",
  "version": "0.2",
  "description": "MagicFrame is a Digital Photo/Video Frame",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "start": "node js/main.js",
    "dev": "concurrently 'npm:dev:server' 'npm:dev:css'",
    "dev:server": "nodemon js/main.js",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/main.css -o ./public/css/main.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/css/main.css -o ./public/css/main.css --minify",
    "test:prettier": "npx prettier . --check",
    "prettier": "npx prettier . --write",
    "migration": "node js/migration.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Speidy674/MagicFrame.git"
  },
  "keywords": [
    "magic frame",
    "magic",
    "frame"
  ],
  "author": "Speidy674",
  "contributors": [
    "https://github.com/Speidy674/MagicFrame/graphs/contributors"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Speidy674/MagicFrame/issues"
  },
  "homepage": "https://github.com/Speidy674/MagicFrame#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "cookie-parser": "^1.4.7",
    "cron-translate": "^2.1.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "lucide": "^1.40.0",
    "mustache": "^4.2.0",
    "mustache-express": "^1.3.2",
    "node-cron": "^4.6.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
