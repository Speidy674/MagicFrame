<!DOCTYPE html>
<html class="dark">

    <head>
        <meta charset="UTF-8">
        <title>MagicFrame - Dashboard - {{pageTitle}}</title>
        <link rel="stylesheet" href="/css/main.css" />
        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/libs/mustache.min.js"></script>
        <script src="/js/libs/lucide.min.js"></script>
        <script src="/js/core.js" type="module" defer></script>
        <script src="/js/dashboard/scenes/detail.js" type="module" defer></script>
    </head>

    <body class="bg-background text-foreground antialiased">

        {{>loader}}

        <div class="flex flex-col m-auto min-h-svh w-[95svw] md:w-[98svw] max-w-480">

            {{>dashboard.header}}

            <div class="grow flex gap-2">

                {{>dashboard.navigation}}

                <main class="grow">
                    <div class="grid grid-cols-7 grid-rows-4 gap-5 w-full p-3">
                        <div
                            class="col-span-4 row-span-3 row-start-2 backdrop-blur-5 border shadow-xl shadow-accent/25 rounded-3xl border-solid border-accent p-12 w-full mx-4 glow">
                            1
                        </div>
                        <div
                            class="col-span-3 row-span-3 col-start-5 row-start-2 backdrop-blur-5 border shadow-xl shadow-accent/25 rounded-3xl border-solid border-accent p-12 w-full mx-4 glow">
                            preview
                        </div>
                        <div
                            class="col-span-7 backdrop-blur-5 border shadow-xl shadow-accent/25 rounded-3xl border-solid border-accent p-12 w-full mx-4 glow">
                            4
                        </div>
                    </div>
                </main>
            </div>

            {{>dashboard.footer}}

        </div>

    </body>

</html>