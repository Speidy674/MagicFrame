<!DOCTYPE html>
<html class="dark">

    <head>
        <meta charset="UTF-8">
        <title>MagicFrame - Dashboard - Main</title>
        <link rel="stylesheet" href="/css/main.css" />
        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/libs/mustache.min.js"></script>
        <script src="/js/libs/lucide.min.js"></script>
        <script src="/js/core.js" type="module" defer></script>
        <script src="/js/dashboard/main.js" type="module" defer></script>
    </head>

    <body class="bg-background text-foreground antialiased">

        {{>loader}}

        <div class="flex flex-col m-auto min-h-svh w-[95svw] md:w-[98svw] max-w-480">

            {{>dashboard.header}}

            <div class="grow flex gap-2">

                {{>dashboard.navigation}}

                <main class="grow">
                    <div class="grid grid-cols-4 gap-8 py-8 px-2">
                        <div
                            class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl col-span-2">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="gallery-horizontal-end"></i>
                                Frames
                            </div>
                            <span id="frameCount"></span>
                        </div>
                        <div
                            class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl col-span-2">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="gallery-horizontal-end"></i>
                                Frames Online
                            </div>
                            <span id="frameOnlineCount"></span>
                        </div>
                        <div class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="images"></i>
                                Media
                            </div>
                            <span id="mediaCount"></span>
                        </div>
                        <div class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="sticky-notes"></i>
                                Scenes
                            </div>
                            <span id="sceneCount"></span>
                        </div>
                        <div class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="list-video"></i>
                                Playlists
                            </div>
                            <span id="playlistCount"></span>
                        </div>
                        <div class="bg-card border border-accent/60 shadow-xl shadow-accent/15 min-h-22 p-3 rounded-xl">
                            <div class="w-full font-bold inline-flex gap-2 text-muted">
                                <i data-lucide="monitor-cog"></i>
                                Crons
                            </div>
                            <span id="cronCounts"></span>
                        </div>
                    </div>
                </main>
            </div>

            {{>dashboard.footer}}

        </div>

    </body>

</html>