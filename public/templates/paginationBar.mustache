<div id="{{barContainerId}}"
    class="flex items-center justify-between border-t border-white/10 px-4 py-3 sm:px-6 sticky bottom-11 bg-background/75">
    <div class="flex flex-1 justify-between sm:hidden">
        <a href="#"
            class="relative inline-flex items-center rounded-md border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-gray-200 hover:bg-white/10">Previous</a>
        <a href="#"
            class="relative ml-3 inline-flex items-center rounded-md border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-gray-200 hover:bg-white/10">Next</a>
    </div>
    <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
        <div>
            <p class="text-sm text-gray-300 hidden">
                Showing
                <span class="font-medium">{{pagination.from}}</span>
                to
                <span class="font-medium">{{pagination.to}}</span>
                of
                <span class="font-medium">{{pagination.total}}</span>
                results
            </p>
        </div>
        <div>
            <nav aria-label="Pagination" class="isolate inline-flex -space-x-px rounded-md">
                {{#pagination.hasPreviousPage}}
                    <a href="#" data-pagination-btn="previous"
                        class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 inset-ring inset-ring-gray-700 hover:bg-white/5 focus:z-20 focus:outline-offset-0">
                        <span class="sr-only">Previous</span>
                        <i data-lucide="chevron-left"></i>
                    </a>
                {{/pagination.hasPreviousPage}}

                {{#pagination.pages}}
                    {{#pagination.pageIsNumber}} <a href='#' data-pagination-btn="{{.}}" {{/pagination.pageIsNumber}}
                            {{^pagination.pageIsNumber}} <span {{/pagination.pageIsNumber}}
                            class="{{#pagination.pageIsActive}} bg-primary{{/pagination.pageIsActive}} relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-200 inset-ring inset-ring-gray-700 {{#pagination.pageIsNumber}} hover:bg-foreground/5 focus:z-20 {{/pagination.pageIsNumber}} focus:outline-offset-0">
                            {{.}}

                            {{#pagination.pageIsNumber}} </a> {{/pagination.pageIsNumber}}
                    {{^pagination.pageIsNumber}} </span>
                    {{/pagination.pageIsNumber}}

                {{/pagination.pages}}
                {{#pagination.hasNextPage}}
                    <a href="#" data-pagination-btn="next"
                        class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 inset-ring inset-ring-gray-700 hover:bg-white/5 focus:z-20 focus:outline-offset-0">
                        <span class="sr-only">Next</span>

                        <i data-lucide="chevron-right"></i>
                    </a>
                {{/pagination.hasNextPage}}
            </nav>
        </div>
    </div>
</div>